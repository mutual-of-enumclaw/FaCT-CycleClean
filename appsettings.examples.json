{
  "// This is an example configuration showing different logging scenarios": "",
  
  "// For minimal logging (only policy processing and results)": {
    "Db2": {
      "MaxPolicyBatchSize": 1000,
      "// Set to 0 for unlimited, or any positive number to limit": ""
    },
    "Logging": {
      "LogLevel": {
        "Default": "Warning",
        "Fact.BatchCleaner": "Information"
      },
      "File": {
        "LogDirectory": "E:\\moe\\CycleClean\\logs",
        "LogFileName": "CycleCleaner_{Date}.log",
        "// {Date} will be replaced with YYYYMMDD_HHMM (e.g., CycleCleaner_20241219_1430.log)": "",
        "VerboseLogging": false,
        "IncludeTimestamps": true,
        "RetainDays": 30
      }
    }
  },

  "// For detailed debugging (includes HTTP requests, XML content, etc.)": {
    "Db2": {
      "MaxPolicyBatchSize": 100,
      "// Smaller batch size for debugging": ""
    },
    "Logging": {
      "LogLevel": {
        "Default": "Debug",
        "Fact.BatchCleaner": "Trace"
      },
      "File": {
        "LogDirectory": "E:\\moe\\CycleClean\\logs\\Debug",
        "LogFileName": "CycleCleaner_Debug_{Date}.log",
        "// Creates files like: CycleCleaner_Debug_20241219_1430.log": "",
        "VerboseLogging": true,
        "IncludeTimestamps": true,
        "RetainDays": 7
      }
    }
  },

  "// For production (errors and policy results only)": {
    "Logging": {
      "LogLevel": {
        "Default": "Error",
        "Fact.BatchCleaner": "Information"
      },
      "File": {
        "LogDirectory": "E:\\moe\\CycleClean\\logs\\Production",
        "LogFileName": "CycleCleaner_Prod_{Date}.log",
        "// Creates files like: CycleCleaner_Prod_20241219_1430.log": "",
        "VerboseLogging": false,
        "IncludeTimestamps": true,
        "RetainDays": 90
      }
    }
  },

  "// For unlimited processing (no LIMIT clause)": {
    "Db2": {
      "MaxPolicyBatchSize": 0,
      "// Set to 0 to process ALL matching policies": ""
    },
    "File": {
      "LogFileName": "CycleCleaner_Full_{Date}.log",
      "// Example: CycleCleaner_Full_20241219_1430.log": ""
    }
  }
}